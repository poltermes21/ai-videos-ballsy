# Copy to .env and fill in real values.

ANTHROPIC_API_KEY=      # writes the script
ELEVENLABS_API_KEY=     # voices the script
ELEVENLABS_VOICE_ID=    # which ElevenLabs voice to use
FIRECRAWL_API_KEY=      # scrapes match articles for context

YOUTUBE_CLIENT_ID=      # Google Cloud OAuth client (YouTube Data API v3)
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=      # TikTok for Developers app (Content Posting API)
TIKTOK_CLIENT_SECRET=
